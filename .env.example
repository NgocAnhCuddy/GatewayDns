# Dùng cho local dev với `wrangler pages dev`.
# Copy file này thành .dev.vars (KHÔNG commit .dev.vars vào git).

# API Token tạo tại: https://dash.cloudflare.com/profile/api-tokens
# Quyền cần có (Account level):
#   - Access: Organizations, Identity Providers, and Groups   -> Edit
#   - Access: Apps and Policies                                -> Edit
#   - Zero Trust                                                -> Edit
#   - Logs                                                      -> Read
CF_API_TOKEN=your-api-token-here

# Account ID: xem ở Cloudflare Dashboard, góc phải trang tổng quan domain bất kỳ,
# hoặc trong URL: dash.cloudflare.com/<ACCOUNT_ID>/...
CF_ACCOUNT_ID=your-account-id-here
